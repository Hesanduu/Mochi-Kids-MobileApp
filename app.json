{
  "expo": {
    "name": "mochi-kids-app",
    "slug": "mochi-kids-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mochikidsapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.mochikids.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mochikids.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Mochi Kids needs access to save the pictures you make to your Photos.",
          "savePhotosPermission": "Mochi Kids saves the pictures you make to your Photos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-audio",
        {
          "microphonePermission": "Mochi Kids uses the microphone so your child can practise saying words with Mochi."
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#0274BD"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "932696f5-2eb0-4884-b47c-9cc00f6429bb"
      }
    },
    "owner": "hesanduuu"
  }
}
