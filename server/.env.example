# Copy this file to server/.env and fill the keys.
# server/.env is git-ignored.

# From https://platform.openai.com/api-keys
OPENAI_API_KEY=

# From https://unsplash.com/oauth/applications (your app's "Access Key")
UNSPLASH_ACCESS_KEY=

# Port the server listens on (the app's EXPO_PUBLIC_API_URL must use the same one)
PORT=3000

# Firebase key file used to check that requests come from logged-in parents.
# Download it from Firebase console > Project settings > Service accounts.
# Keep it in server/ and never share or commit it.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
